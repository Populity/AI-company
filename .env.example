# Скопируй этот файл в .env и заполни — только для запуска на своём компьютере.
# На GitHub эти же значения хранятся в Settings → Secrets and variables → Actions.
CLAUDE_CODE_OAUTH_TOKEN=
FAL_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
INSTAGRAM_ACCESS_TOKEN=
# необязательно
YOUTUBE_API_KEY=
INSTAGRAM_USER_ID=
GH_PAT=
# 1 = сухой режим: ничего не тратит и не публикует
DRY_RUN=
# 0 = не отправлять офис в GitHub
OFFICE_PUSH=
